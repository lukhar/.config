# Notifications on the Framework laptop (piecyk uses dunst).
# Reload after editing: makoctl reload
# Solarized dark, like config/waybar/style.css.

font=DejaVuSansM Nerd Font Mono 10
anchor=top-right
# clear of the bar
margin=8
padding=10
width=360
border-size=2
border-radius=0
max-visible=5

background-color=#073642
text-color=#93a1a1
border-color=#268bd2
progress-color=over #586e75

default-timeout=5000

[urgency=low]
border-color=#586e75

# low battery and the like: stays until dismissed (Super+N)
[urgency=critical]
border-color=#dc322f
default-timeout=0
