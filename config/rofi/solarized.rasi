/**
 * Solarized dark, for the Framework laptop: hyprland.lua passes it with
 * -theme, which replaces the theme half of config.rasi. The configuration
 * block (combi-modi, ...) still comes from config.rasi, shared with piecyk.
 */

* {
    base03:     #002b36;
    base02:     #073642;
    base01:     #586e75;
    base0:      #839496;
    base1:      #93a1a1;
    blue:       #268bd2;
    red:        #dc322f;

    font:             "DejaVuSansM Nerd Font Mono 12";
    background-color: transparent;
    text-color:       @base0;
}

window {
    location:         center;
    width:            40%;
    background-color: @base03;
    border:           2px;
    border-color:     @blue;
    padding:          8px;
}

mainbox {
    children: [ inputbar, message, listview ];
    spacing:  8px;
}

inputbar {
    children:         [ prompt, entry ];
    spacing:          8px;
    padding:          6px;
    background-color: @base02;
}

prompt {
    text-color: @blue;
}

entry {
    text-color:        @base1;
    placeholder:       "";
}

message {
    padding:          6px;
    background-color: @base02;
}

listview {
    lines:   12;
    dynamic: true;
    spacing: 2px;
}

element {
    padding:  4px 6px;
    spacing:  8px;
}

element-icon {
    size: 1.2em;
}

element-text, element-icon {
    text-color: inherit;
}

element selected.normal {
    background-color: @base02;
    text-color:       @base1;
    border:           0 0 0 2px;
    border-color:     @blue;
}

element normal.urgent, element selected.urgent {
    text-color: @red;
}

element normal.active, element selected.active {
    text-color: @blue;
}
