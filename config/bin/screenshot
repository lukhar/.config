#!/bin/sh
# Wayland screenshot, bound to Print (region) and Shift+Print (whole screen) in
# hyprland.lua: saved under ~/Pictures/Screenshots and copied to the clipboard.
#
#   screenshot          select a region with slurp
#   screenshot full     every output

dir="${XDG_PICTURES_DIR:-$HOME/Pictures}/Screenshots"
file="$dir/$(date +%Y-%m-%d_%H-%M-%S).png"
mkdir -p "$dir"

case "${1:-region}" in
  full)
    grim "$file" ;;
  region)
    # slurp exits non-zero on Escape: nothing taken, nothing to report
    geometry=$(slurp) || exit 0
    grim -g "$geometry" "$file" ;;
  *)
    echo "usage: screenshot [region|full]" >&2
    exit 2 ;;
esac || exit 1

wl-copy --type image/png < "$file"
notify-send --app-name=screenshot --icon="$file" "Screenshot" "${file#"$HOME"/}" 2>/dev/null
exit 0
