# Generated or machine-local files inside the tracked config.
#
# This was a ~50-rule denylist, because the repository *was* $XDG_CONFIG_HOME
# and every application that wrote into ~/.config landed in the working tree.
# Since the split into config/ and home/ that scribble goes somewhere the
# repository does not contain, so what is left are only the things genuinely
# produced inside this tree.
#
# Secrets are covered globally, by $XDG_CONFIG_HOME/git/ignore (*.secret).

# nvim: compiled spell files, rebuilt from the .add wordlists
*.spl

# tmux: cloned on first run by tmux.conf, pinned there rather than vendored
config/tmux/plugins/resurrect/
config/tmux/plugins/jump/

# written by the applications themselves
config/qutebrowser/autoconfig.yml
config/qutebrowser/qsettings
config/Thunar/accels.scm

# claude syncs these as UUID-named buckets; generated, not config
config/aiassist/claude/skills/synced/

# generated by bootstrap.sh; poetry bakes a machine-specific path into it
config/zsh/completions/_poetry

# vim-obsession drops a session here when nvim is opened inside this repository
.vim/

# Claude Code's project-local settings for this repository
.claude/
